{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comptia-practice-trainer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // All requests hit the worker so the canonical-host redirect covers pages,
    // not just /api. Asset serving remains a free ASSETS.fetch subrequest.
    "run_worker_first": true
  },
  // Keep the old workers.dev URL alive so pre-domain links 301 to cert900.com.
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "cert900.com", "custom_domain": true },
    { "pattern": "www.cert900.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["30 14 * * *", "0 15 * * 1"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comptia-trainer",
      "database_id": "b1aa1018-db54-4b96-952a-1a193be84a8a"
    }
  ],
  // Cloudflare Email Sending binding. Harmless on its own, and currently
  // UNUSED: Email Sending requires the Workers Paid plan, so mail goes through
  // Resend instead (worker/mail.ts picks whichever transport is configured).
  // Kept so switching back is a one-line change if the plan ever changes.
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://cert900.com",
    // Who can open /admin and read reported questions. Comma-separated. A
    // session only counts as admin if its address is BOTH on this list and
    // verified, so listing an address that has no account yet cannot be claimed
    // by password signup. Empty/unset = no admins, and /api/admin/* 404s.
    "ADMIN_EMAILS": "johnathanv16@gmail.com",
    // The address transactional mail is sent from. Setting it enables
    // email/password sign-in.
    //
    // DO NOT SET IT until `node tools/mail-check.mjs <address>` reports OK AND
    // the mail actually arrives. A misconfigured transport fails silently:
    // Better Auth swallows the error, the UI still says the reset link was
    // sent, and that account is then unrecoverable.
    //
    // Transport is whichever credential exists (see worker/mail.ts):
    //   RESEND_API_KEY secret -> Resend      (free tier, no plan change)
    //   EMAIL binding         -> Cloudflare  (needs Workers Paid)
    //
    // Use a sending SUBDOMAIN, e.g. no-reply@send.cert900.com. The apex already
    // carries an SPF record and MX records for Email Routing, and a second SPF
    // record at the apex would break SPF for both. A subdomain is also Resend's
    // own recommendation, since it isolates sending reputation.
    "AUTH_EMAIL_FROM": "no-reply@send.cert900.com"
  }
}
