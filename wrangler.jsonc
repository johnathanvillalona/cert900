{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comptia-practice-trainer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // All requests hit the worker so the canonical-host redirect covers pages,
    // not just /api. Asset serving remains a free ASSETS.fetch subrequest.
    "run_worker_first": true
  },
  // Keep the old workers.dev URL alive so pre-domain links 301 to cert900.com.
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "cert900.com", "custom_domain": true },
    { "pattern": "www.cert900.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["30 14 * * *", "0 15 * * 1"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comptia-trainer",
      "database_id": "b1aa1018-db54-4b96-952a-1a193be84a8a"
    }
  ],
  // Transactional mail (password reset + address confirmation) for email
  // sign-in. The binding is harmless on its own; AUTH_EMAIL_FROM below is what
  // turns email/password auth on.
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://cert900.com",
    // Set this to "no-reply@cert900.com" to enable email/password sign-in.
    // REQUIRED FIRST: onboard the sending domain, which adds the SPF and DKIM
    // records — `npx wrangler email sending enable cert900.com`, or Dashboard >
    // Compute & AI > Email Service > Email Sending > Onboard Domain. Until then
    // this stays empty and the site offers Google (and Apple on iOS) only,
    // because password sign-in without a delivered reset link is a permanent
    // lockout for anyone who forgets one.
    "AUTH_EMAIL_FROM": ""
  }
}
