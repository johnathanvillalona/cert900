{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comptia-practice-trainer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "cert900.com", "custom_domain": true },
    { "pattern": "www.cert900.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comptia-trainer",
      "database_id": "b1aa1018-db54-4b96-952a-1a193be84a8a"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://cert900.com"
  }
}
