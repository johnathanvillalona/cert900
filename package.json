{
  "name": "comptia-practice-trainer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build && tsx tools/prerender.tsx",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-data": "node tools/extract-data.mjs",
    "test:browser": "playwright test",
    "test:worker": "node tools/qa/isolated-worker.mjs",
    "preview:isolated": "node tools/qa/isolated-worker.mjs --serve --port=4174",
    "test:simulations": "playwright test --config playwright.simulations.config.ts"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.23",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.3",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "vite": "^7.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  }
}
